FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Relative paths are resolved against the project root automatically.
DATABASE_URL=sqlite:///database/finance.db
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
# Dashboard reminder when no backup newer than this many days
BACKUP_MAX_AGE_DAYS=7

# Telegram bot (run separately: python -m telegram_bot)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_TIMEZONE=Asia/Kolkata
TELEGRAM_NOTIFY_STARTUP=false
TELEGRAM_PENDING_TTL_MINUTES=60
TELEGRAM_LINK_CODE_TTL_MINUTES=30
